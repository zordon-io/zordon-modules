    outputs = {
        zone = {
            description = "Primary DNS zone served by this CoreDNS instance."
            type        = string
            value       = inputs.zone
        }
        port = {
            description = "UDP/TCP port CoreDNS listens on."
            type        = number
            value       = component.coredns.service.go.coredns.vars.port
        }
        dns = {
            description = "Loopback host:port address of the CoreDNS listener."
            type        = string
            value       = "127.0.0.1:${component.coredns.service.go.coredns.vars.port}"
        }
        ready_port = {
            description = "HTTP port of the ready endpoint."
            type        = number
            value       = inputs.ready_port
        }
        ready_url = {
            description = "HTTP URL of the ready endpoint (/ready)."
            type        = string
            value       = "http://127.0.0.1:${inputs.ready_port}/ready"
        }
        health_port = {
            description = "HTTP port of the health endpoint."
            type        = number
            value       = inputs.health_port
        }
        health_url = {
            description = "HTTP URL of the health endpoint (/health)."
            type        = string
            value       = "http://127.0.0.1:${inputs.health_port}/health"
        }
        metrics_port = {
            description = "HTTP port of the Prometheus metrics endpoint."
            type        = number
            value       = inputs.metrics_port
        }
        metrics_url = {
            description = "HTTP URL of the Prometheus metrics endpoint (/metrics)."
            type        = string
            value       = "http://127.0.0.1:${inputs.metrics_port}/metrics"
        }
        pprof_port = {
            description = "HTTP port of the pprof endpoint."
            type        = number
            value       = inputs.pprof_port
        }
        corefile = {
            description = "Filesystem path to the generated Corefile."
            type        = string
            value       = component.coredns.service.go.coredns.file.corefile.path
        }
        ready = {
            description = "Readiness barrier reference for the CoreDNS service."
            type        = string
            value       = component.coredns.service.go.coredns.runtime.ready
        }
    }

    component "coredns" {
        toolchain {
            go {
                version = "1.26.0"
            }
        }

        service "go" "coredns" {
            git {
                url = "github.com/coredns/coredns"
                tag = "v1.15.0"
            }

            vars = {
                zone = inputs.zone
                dns  = inputs.dns_port != null ? inputs.dns_port : inputs.port
                port = inputs.dns_port != null ? inputs.dns_port : inputs.port
            }

            sudo "resolver" {
                enabled = features.resolver
                check   = "grep -qxF 'port ${self.vars.port}' /etc/resolver/${inputs.zone} 2>/dev/null"
                apply   = <<-EOT
                    mkdir -p /etc/resolver && printf 'nameserver 127.0.0.1\nport ${self.vars.port}\n' > /etc/resolver/${inputs.zone}
                EOT
                verify  = "grep -qxF 'port ${self.vars.port}' /etc/resolver/${inputs.zone}"
            }

            file "corefile" {
                path = "${fs::etc()}/Corefile"
                body = <<-EOF
%{for name, body in inputs.snippets}(${name}) {
    ${body}
}

%{endfor}${inputs.transport != "" ? "${inputs.transport}://" : ""}${inputs.zone}%{for z in inputs.zones} ${inputs.transport != "" ? "${inputs.transport}://" : ""}${z}%{endfor}:${self.vars.port} {
%{for imp in inputs.imports ~}
    import ${imp}
%{endfor ~}
%{if inputs.root != "" ~}
    root ${inputs.root}
%{endif ~}
%{if inputs.metadata != null ~}
%{if inputs.metadata.enabled ~}
    metadata%{for z in inputs.metadata.zones} ${z}%{endfor}
%{endif ~}
%{endif ~}
%{if inputs.geoip != null ~}
    geoip ${inputs.geoip.db_file}%{if inputs.geoip.edns_subnet} {
        edns-subnet
    }%{endif}
%{endif ~}
%{if inputs.cancel != null ~}
%{if inputs.cancel.enabled ~}
    cancel${inputs.cancel.timeout != "" ? " ${inputs.cancel.timeout}" : ""}
%{endif ~}
%{endif ~}
%{if inputs.proxyproto != null ~}
    proxyproto {
%{if [for x in inputs.proxyproto.allow : x] != [] ~}
        allow%{for cidr in inputs.proxyproto.allow} ${cidr}%{endfor}
%{endif ~}
%{if inputs.proxyproto.default != "" ~}
        default ${inputs.proxyproto.default}
%{endif ~}
%{if inputs.proxyproto.udp_session_tracking_ttl != "" ~}
        udp_session_tracking ${inputs.proxyproto.udp_session_tracking_ttl}${inputs.proxyproto.udp_session_tracking_max_sessions != null ? " ${inputs.proxyproto.udp_session_tracking_max_sessions}" : ""}
%{endif ~}
%{if inputs.proxyproto.tlv_metadata ~}
        tlv_metadata
%{endif ~}
    }
%{endif ~}
%{if inputs.quic != null ~}
    quic {
%{if inputs.quic.max_streams != null ~}
        max_streams ${inputs.quic.max_streams}
%{endif ~}
%{if inputs.quic.worker_pool_size != null ~}
        worker_pool_size ${inputs.quic.worker_pool_size}
%{endif ~}
    }
%{endif ~}
%{if inputs.grpc_server != null ~}
    grpc_server {
%{if inputs.grpc_server.max_streams != null ~}
        max_streams ${inputs.grpc_server.max_streams}
%{endif ~}
%{if inputs.grpc_server.max_connections != null ~}
        max_connections ${inputs.grpc_server.max_connections}
%{endif ~}
    }
%{endif ~}
%{if inputs.https != null ~}
    https {
%{if inputs.https.max_connections != null ~}
        max_connections ${inputs.https.max_connections}
%{endif ~}
%{if inputs.https.path != "" ~}
        path ${inputs.https.path}
%{endif ~}
    }
%{endif ~}
%{if inputs.https3 != null ~}
    https3 {
%{if inputs.https3.max_streams != null ~}
        max_streams ${inputs.https3.max_streams}
%{endif ~}
%{if inputs.https3.worker_pool_size != null ~}
        worker_pool_size ${inputs.https3.worker_pool_size}
%{endif ~}
%{if inputs.https3.path != "" ~}
        path ${inputs.https3.path}
%{endif ~}
    }
%{endif ~}
%{if inputs.timeouts != null ~}
    timeouts {
%{if inputs.timeouts.read != "" ~}
        read ${inputs.timeouts.read}
%{endif ~}
%{if inputs.timeouts.write != "" ~}
        write ${inputs.timeouts.write}
%{endif ~}
%{if inputs.timeouts.idle != "" ~}
        idle ${inputs.timeouts.idle}
%{endif ~}
    }
%{endif ~}
%{if inputs.multisocket != null ~}
%{if inputs.multisocket.enabled ~}
    multisocket${inputs.multisocket.num_sockets != null ? " ${inputs.multisocket.num_sockets}" : ""}
%{endif ~}
%{endif ~}
%{if features.reload || (inputs.reload != null && inputs.reload.enabled) ~}
    reload${inputs.reload != null && inputs.reload.interval != "" ? " ${inputs.reload.interval}" : ""}${inputs.reload != null && inputs.reload.jitter != "" ? " ${inputs.reload.jitter}" : ""}
%{endif ~}
%{if inputs.nsid != null ~}
%{if inputs.nsid.enabled ~}
    nsid${inputs.nsid.data != "" ? " ${inputs.nsid.data}" : ""}
%{endif ~}
%{endif ~}
%{if inputs.bufsize != null ~}
    bufsize ${inputs.bufsize}
%{endif ~}
%{if inputs.bind != null ~}
%{if [for x in inputs.bind.except : x] != [] ~}
    bind {
%{if [for x in inputs.bind.addresses : x] != [] ~}
        addresses%{for a in inputs.bind.addresses} ${a}%{endfor}
%{endif ~}
        except%{for e in inputs.bind.except} ${e}%{endfor}
    }
%{else ~}
    bind%{for a in inputs.bind.addresses} ${a}%{endfor}
%{endif ~}
%{else ~}
    bind 127.0.0.1
%{endif ~}
%{if features.debug || inputs.debug ~}
    debug
%{endif ~}
%{if inputs.trace != null ~}
    trace${inputs.trace.endpoint_type != "" ? " ${inputs.trace.endpoint_type}" : ""}${inputs.trace.endpoint != "" ? " ${inputs.trace.endpoint}" : ""} {
%{if inputs.trace.every != null ~}
        every ${inputs.trace.every}
%{endif ~}
