package "coredns" {
    features = {
        resolver = {
            description = "Writes /etc/resolver/<zone> with sudo (macOS), so the host resolves *.<zone> through CoreDNS."
        }
        metrics = {
            description = "Enables the Prometheus metrics endpoint (/metrics) on the primary server block."
        }
        health = {
            description = "Enables the HTTP health check endpoint (/health) on the primary server block."
        }
        pprof = {
            description = "Enables the runtime pprof profiling HTTP server (/debug/pprof) on the primary server block."
        }
        log = {
            description = "Enables DNS query logging on the primary server block."
        }
        debug = {
            description = "Disables panic recovery and enables debug logging globally."
        }
        reload = {
            description = "Enables automatic graceful reload when the Corefile changes."
        }
        loop = {
            description = "Enables forwarding loop detection on the primary server block."
        }
        shed = {
            description = "Enables UDP response write serialization and overload shedding on the primary server block."
        }
        local = {
            description = "Responds locally to localhost and reverse loopback queries without forwarding upstream."
        }
        any = {
            description = "Blocks ANY queries with a minimal RFC 8482 HINFO response on the primary server block."
        }
        minimal = {
            description = "Minimizes DNS response sizes by omitting unnecessary AUTHORITY and ADDITIONAL records."
        }
        whoami = {
            description = "Responds with the client's IP address, port, and transport in the ADDITIONAL section."
        }
    }

    inputs = {
        port = {
            description = "UDP and TCP port CoreDNS listens on (-dns.port). Fixed by default so /etc/resolver/<zone> remains valid across restarts."
            type        = number
            default     = 49564
        }
        dns_port = {
            description = "Optional override for port; when set, takes precedence over inputs.port."
            type        = number
            default     = null
        }
        ready_port = {
            description = "HTTP port for the ready plugin (/ready) used by readiness probes."
            type        = number
            default     = net::pickport()
        }
        health_port = {
            description = "HTTP port for the health plugin (/health) when enabled."
            type        = number
            default     = net::pickport()
        }
        metrics_port = {
            description = "HTTP port for the prometheus metrics plugin (/metrics) when enabled."
            type        = number
            default     = net::pickport()
        }
        pprof_port = {
            description = "HTTP port for the pprof profiling plugin (/debug/pprof) when enabled."
            type        = number
            default     = net::pickport()
        }
        zone = {
            description = "Primary DNS zone served by the default server block and registered in /etc/resolver."
            type        = string
            default     = "test"
        }
        zones = {
            description = "Additional DNS zones served by the primary server block alongside inputs.zone."
            type        = list(string)
            default     = []
        }
        transport = {
            description = "Transport scheme prefix for the primary server block (dns, tls, https, https3, quic, or grpc)."
            type        = string
            default     = ""
        }
        quiet = {
            description = "Suppresses the startup stanza output (-quiet)."
            type        = bool
            default     = false
        }
        log_format = {
            description = "Process log output format (-log-format): text or json."
            type        = string
            default     = "text"
        }
        pidfile = {
            description = "Path to write the CoreDNS PID file (-pidfile)."
            type        = string
            default     = ""
        }
        loopback_fallback = {
            description = "Synthesizes loopback A and AAAA responses via the template plugin on the primary server block when no custom templates, records, hosts, forwards, or zone backends are configured."
            type        = bool
            default     = true
        }
        loopback_ipv4 = {
            description = "IPv4 address returned by the default loopback fallback template for A queries."
            type        = string
            default     = "127.0.0.1"
        }
        loopback_ipv6 = {
            description = "IPv6 address returned by the default loopback fallback template for AAAA queries."
            type        = string
            default     = "::1"
        }
        loopback_ttl = {
            description = "TTL in seconds for records synthesized by the default loopback fallback template."
            type        = number
            default     = 60
        }
        snippets = {
            description = "Named reusable Corefile snippet bodies rendered as (name) { ... } blocks at the top of the Corefile."
            type        = map(string)
            default     = {}
        }
        imports = {
            description = "Snippet names to import into the primary server block."
            type        = list(string)
            default     = []
        }
        hosts = {
            description = "Static host entries merged into the hosts plugin of the primary server block; the map key is used as the primary hostname alongside any aliases in hostnames."
            type = map(object({
                ip        = string
                hostnames = optional(list(string), [])
            }))
            default = {}
        }
        records = {
            description = "Static DNS resource records served on the primary server block via template rules."
            type = map(object({
                name  = string
                type  = optional(string, "A")
                class = optional(string, "IN")
                ttl   = optional(number, 60)
                data  = string
            }))
            default = {}
        }
        rewrites = {
            description = "Named rewrite rules (without the leading 'rewrite' keyword) applied on the primary server block."
            type        = map(string)
            default     = {}
        }
        templates = {
            description = "Named template plugin blocks applied on the primary server block."
            type = map(object({
                class             = optional(string, "IN")
                type              = optional(string, "ANY")
                zones             = optional(list(string), [])
                regex             = optional(string, ".*")
                answer            = optional(list(string), [])
                additional        = optional(list(string), [])
                authority         = optional(list(string), [])
                rcode             = optional(string, "")
                fallthrough       = optional(bool, false)
                fallthrough_zones = optional(list(string), [])
                upstream          = optional(string, "")
            }))
            default = {}
        }
        forwards = {
            description = "Named forward plugin blocks applied on the primary server block."
            type = map(object({
                from                             = optional(string, ".")
                to                               = list(string)
                except                           = optional(list(string), [])
                force_tcp                        = optional(bool, false)
                prefer_udp                       = optional(bool, false)
                expire                           = optional(string, "")
                max_fails                        = optional(number)
                tls_cert                         = optional(string, "")
                tls_key                          = optional(string, "")
                tls_ca                           = optional(string, "")
                tls_servername                   = optional(string, "")
                policy                           = optional(string, "")
                health_check                     = optional(string, "")
                health_check_domain              = optional(string, "")
                dnstap                           = optional(bool, false)
                max_concurrent                   = optional(number)
                next                             = optional(list(string), [])
                failfast_all_unhealthy_upstreams = optional(bool, false)
                failovers                        = optional(list(string), [])
            }))
            default = {}
        }
        root = {
            description = "Root directory for file, auto, sign, tls, and dnssec plugins on the primary server block."
            type        = string
            default     = ""
        }
        metadata = {
            description = "Enables the metadata collector plugin on the primary server block."
            type = object({
                enabled = optional(bool, true)
                zones   = optional(list(string), [])
            })
            default = null
        }
        geoip = {
            description = "Configures the MaxMind MMDB geoip plugin on the primary server block."
            type = object({
                db_file     = string
                edns_subnet = optional(bool, false)
            })
            default = null
        }
        cancel = {
            description = "Configures the request context cancellation timeout plugin on the primary server block."
            type = object({
                enabled = optional(bool, true)
                timeout = optional(string, "")
            })
            default = null
        }
        proxyproto = {
            description = "Configures PROXY protocol v1/v2 support on the primary server block."
            type = object({
                allow                             = optional(list(string), [])
                default                           = optional(string, "")
                udp_session_tracking_ttl          = optional(string, "")
                udp_session_tracking_max_sessions = optional(number)
                tlv_metadata                      = optional(bool, false)
            })
            default = null
        }
        quic = {
            description = "Configures DNS-over-QUIC (DoQ) transport parameters on the primary server block."
            type = object({
                max_streams      = optional(number)
                worker_pool_size = optional(number)
            })
            default = null
        }
        grpc_server = {
            description = "Configures incoming gRPC server connection and stream limits on the primary server block."
            type = object({
                max_streams     = optional(number)
                max_connections = optional(number)
            })
            default = null
        }
        https = {
            description = "Configures DNS-over-HTTPS (DoH) transport options on the primary server block."
            type = object({
                max_connections = optional(number)
                path            = optional(string, "")
            })
            default = null
        }
        https3 = {
            description = "Configures DNS-over-HTTP/3 (DoH3) transport options on the primary server block."
            type = object({
                max_streams      = optional(number)
                worker_pool_size = optional(number)
                path             = optional(string, "")
            })
            default = null
        }
        timeouts = {
            description = "Configures TCP, TLS, and DoH read/write/idle timeouts on the primary server block."
            type = object({
                read  = optional(string, "")
                write = optional(string, "")
                idle  = optional(string, "")
            })
            default = null
        }
        multisocket = {
            description = "Configures SO_REUSEPORT multiple listening sockets on the primary server block."
            type = object({
                enabled     = optional(bool, true)
                num_sockets = optional(number)
            })
            default = null
        }
        reload = {
            description = "Configures automatic Corefile reload interval and jitter on the primary server block."
            type = object({
                enabled  = optional(bool, true)
                interval = optional(string, "")
                jitter   = optional(string, "")
            })
            default = null
        }
        nsid = {
            description = "Configures RFC 5001 Name Server Identifier (NSID) replies on the primary server block."
            type = object({
                enabled = optional(bool, true)
                data    = optional(string, "")
            })
            default = null
        }
        bufsize = {
            description = "Limits the EDNS0 UDP payload buffer size (512-4096) on the primary server block."
            type        = number
            default     = null
        }
        bind = {
            description = "Restricts network interfaces or IP addresses to bind on the primary server block."
            type = object({
                addresses = optional(list(string), [])
                except    = optional(list(string), [])
            })
            default = null
        }
        debug = {
            description = "Enables the debug plugin on the primary server block."
            type        = bool
            default     = false
        }
        trace = {
            description = "Configures OpenTracing (Zipkin or Datadog) request tracing on the primary server block."
            type = object({
                endpoint_type             = optional(string, "")
                endpoint                  = optional(string, "")
                every                     = optional(number)
                service                   = optional(string, "")
                client_server             = optional(bool, false)
                datadog_analytics_rate    = optional(number)
                zipkin_max_backlog_size   = optional(number)
                zipkin_max_batch_size     = optional(number)
                zipkin_max_batch_interval = optional(string, "")
            })
            default = null
        }
        ready = {
            description = "Overrides the ready plugin configuration on the primary server block."
            type = object({
                enabled = optional(bool, true)
                address = optional(string, "")
            })
            default = null
        }
        health = {
            description = "Configures the HTTP health check plugin on the primary server block."
            type = object({
                enabled  = optional(bool, true)
                address  = optional(string, "")
                lameduck = optional(string, "")
            })
            default = null
        }
        pprof = {
            description = "Configures the runtime profiling HTTP endpoint on the primary server block."
            type = object({
                enabled    = optional(bool, true)
                address    = optional(string, "")
                block_rate = optional(number)
            })
            default = null
        }
        shed = {
            description = "Enables the shed plugin for UDP response serialization and load shedding on the primary server block."
            type        = bool
            default     = false
        }
        prometheus = {
            description = "Configures the Prometheus metrics endpoint on the primary server block."
            type = object({
                enabled = optional(bool, true)
                address = optional(string, "")
            })
            default = null
        }
        errors = {
            description = "Configures error logging, log consolidation, and panic recovery on the primary server block."
            type = object({
                enabled = optional(bool, true)
                consolidations = optional(list(object({
                    interval   = string
                    pattern    = string
                    show_first = optional(bool, false)
                })), [])
                stacktrace = optional(bool, false)
            })
            default = null
        }
        log = {
            description = "Configures DNS query logging on the primary server block."
            type = object({
                enabled = optional(bool, true)
                name    = optional(string, "")
                format  = optional(string, "")
                classes = optional(list(string), [])
            })
            default = null
        }
        dnstap = {
            description = "Configures dnstap binary logging sinks and listeners on the primary server block."
            type = list(object({
                socket      = string
                listen      = optional(bool, false)
                full        = optional(bool, false)
                writebuffer = optional(number)
                queue       = optional(number)
                identity    = optional(string, "")
                version     = optional(string, "")
                extra       = optional(string, "")
                tls_cert    = optional(string, "")
                tls_key     = optional(string, "")
                tls_ca      = optional(string, "")
                skipverify  = optional(bool, false)
            }))
            default = []
        }
        local = {
            description = "Configures local responses for localhost and reverse loopback zones on the primary server block."
            type = object({
                enabled          = optional(bool, true)
                localhost_prefix = optional(string, "")
            })
            default = null
        }
        dns64 = {
            description = "Configures DNS64 IPv6 synthesis from IPv4 A records on the primary server block."
            type = object({
                zones         = optional(list(string), [])
                prefix        = optional(string, "")
                translate_all = optional(bool, false)
                allow_ipv4    = optional(bool, false)
            })
            default = null
        }
        siit = {
            description = "Configures Stateless IP/ICMP Translation (SIIT) algorithmic address mapping on the primary server block."
            type = object({
                prefix        = string
                zones         = optional(list(string), [])
                translate_all = optional(bool, false)
            })
            default = null
        }
        any = {
            description = "Blocks ANY queries with RFC 8482 HINFO responses on the primary server block."
            type        = bool
            default     = false
        }
        chaos = {
            description = "Configures CH class TXT responses for version.bind and authors.bind on the primary server block."
            type = object({
                enabled = optional(bool, true)
                version = optional(string, "")
                authors = optional(list(string), [])
            })
            default = null
        }
        loadbalance = {
            description = "Configures round-robin or weighted A/AAAA/MX record reordering and subnet preference on the primary server block."
            type = object({
                policy     = optional(string, "round_robin")
                weightfile = optional(string, "")
                reload     = optional(string, "")
                prefer     = optional(list(string), [])
            })
            default = null
        }
        tsig = {
            description = "Configures TSIG keys, request validation, and response signing on the primary server block."
            type = object({
                zones          = optional(list(string), [])
                secrets        = optional(map(string), {})
                secrets_file   = optional(string, "")
                require        = optional(list(string), [])
                require_opcode = optional(list(string), [])
            })
            default = null
        }
        autopath = {
            description = "Configures server-side search path completion on the primary server block."
            type = object({
                zones       = optional(list(string), [])
                resolv_conf = string
            })
            default = null
        }
        acl = {
            description = "Configures access control lists (allow, block, filter, drop) on the primary server block."
            type = list(object({
                zones = optional(list(string), [])
                rules = list(object({
                    action = string
                    type   = optional(string, "")
                    net    = optional(list(string), [])
                }))
            }))
            default = []
        }
        cache = {
            description = "Configures DNS response caching on the primary server block."
            type = object({
                ttl                   = optional(number)
                zones                 = optional(list(string), [])
                success_capacity      = optional(number)
                success_ttl           = optional(number)
                success_min_ttl       = optional(number)
                denial_capacity       = optional(number)
                denial_ttl            = optional(number)
                denial_min_ttl        = optional(number)
                prefetch_amount       = optional(number)
                prefetch_duration     = optional(string, "")
                prefetch_percentage   = optional(number)
                serve_stale_duration  = optional(string, "")
                serve_stale_verify    = optional(string, "")
                servfail              = optional(string, "")
                disable_success_zones = optional(list(string), [])
                disable_denial_zones  = optional(list(string), [])
                keepttl               = optional(bool, false)
            })
            default = null
        }
        header = {
            description = "Configures DNS response header flag and rcode modifications on the primary server block."
            type = list(object({
                selector = optional(string, "")
                actions  = list(string)
            }))
            default = []
        }
        dnssec = {
            description = "Configures on-the-fly DNSSEC signing on the primary server block."
            type = object({
                zones          = optional(list(string), [])
                key_source     = optional(string, "file")
                keys           = list(string)
                cache_capacity = optional(number)
            })
            default = null
        }
        tls = {
            description = "Configures TLS certificates and client authentication for DoT, DoH, DoQ, and gRPC on the primary server block."
            type = object({
                cert        = string
                key         = string
                ca          = optional(string, "")
                client_auth = optional(string, "")
            })
            default = null
        }
        minimal = {
            description = "Enables minimal DNS response sizing on the primary server block."
            type        = bool
            default     = false
        }
        transfer = {
            description = "Configures outgoing AXFR/IXFR zone transfers and NOTIFY targets on the primary server block."
            type = list(object({
                zones  = optional(list(string), [])
                to     = list(string)
                source = optional(string, "")
            }))
            default = []
        }
        dynupdate = {
            description = "Configures RFC 2136 Dynamic DNS UPDATE access policies on the primary server block."
            type = list(object({
                zones      = optional(list(string), [])
                allow_net  = optional(list(string), [])
                allow_tsig = optional(list(string), [])
                allow_name = optional(list(object({
                    pattern = string
                    types   = optional(list(string), [])
                })), [])
                allow_subdomain = optional(list(object({
                    parent = string
                    types  = optional(list(string), [])
                })), [])
                allow_self = optional(list(object({
                    subtree = string
                    types   = optional(list(string), [])
                })), [])
                block_net = optional(list(string), [])
                block_name = optional(list(object({
                    pattern = string
                    types   = optional(list(string), [])
                })), [])
                block_subdomain = optional(list(object({
                    parent = string
                    types  = optional(list(string), [])
                })), [])
                dry_run = optional(bool, false)
                audit   = optional(bool, false)
            }))
            default = []
        }
        hosts_plugin = {
            description = "Configures advanced hosts plugin options (external hosts file, TTL, reload, reverse lookup, fallthrough) on the primary server block."
            type = object({
                file              = optional(string, "")
                zones             = optional(list(string), [])
                inline            = optional(map(list(string)), {})
                ttl               = optional(number)
                reload            = optional(string, "")
                no_reverse        = optional(bool, false)
                fallthrough       = optional(bool, false)
                fallthrough_zones = optional(list(string), [])
            })
            default = null
        }
        route53 = {
            description = "Configures serving zone data from AWS Route 53 on the primary server block."
            type = object({
                zones                 = list(string)
                aws_access_key_id     = optional(string, "")
                aws_secret_access_key = optional(string, "")
                aws_endpoint          = optional(string, "")
                credentials_profile   = optional(string, "")
                credentials_file      = optional(string, "")
                fallthrough           = optional(bool, false)
                fallthrough_zones     = optional(list(string), [])
                refresh               = optional(string, "")
            })
            default = null
        }
        azure = {
            description = "Configures serving zone data from Microsoft Azure DNS on the primary server block."
            type = object({
                zones             = list(string)
                tenant            = string
                client            = string
                secret            = string
                subscription      = string
                environment       = optional(string, "")
                access            = optional(string, "")
                fallthrough       = optional(bool, false)
                fallthrough_zones = optional(list(string), [])
                refresh           = optional(string, "")
            })
            default = null
        }
        clouddns = {
            description = "Configures serving zone data from Google Cloud DNS on the primary server block."
            type = object({
                zones             = list(string)
                credentials       = optional(string, "")
                endpoint          = optional(string, "")
                fallthrough       = optional(bool, false)
                fallthrough_zones = optional(list(string), [])
                refresh           = optional(string, "")
            })
            default = null
        }
        k8s_external = {
            description = "Configures external IP and headless service resolution for Kubernetes on the primary server block."
            type = object({
                zones             = optional(list(string), [])
                apex              = optional(string, "")
                ttl               = optional(number)
                headless          = optional(bool, false)
                fallthrough       = optional(bool, false)
                fallthrough_zones = optional(list(string), [])
            })
            default = null
        }
        kubernetes = {
            description = "Configures Kubernetes DNS-Based Service Discovery on the primary server block."
            type = object({
                zones                  = optional(list(string), [])
                endpoint               = optional(string, "")
                tls_cert               = optional(string, "")
                tls_key                = optional(string, "")
                tls_cacert             = optional(string, "")
                kubeconfig             = optional(string, "")
                kubeconfig_context     = optional(string, "")
                apiserver_qps          = optional(number)
                apiserver_burst        = optional(number)
                apiserver_max_inflight = optional(number)
                namespaces             = optional(list(string), [])
                namespace_labels       = optional(string, "")
                labels                 = optional(string, "")
                pods                   = optional(string, "")
                endpoint_pod_names     = optional(bool, false)
                ttl                    = optional(number)
                noendpoints            = optional(bool, false)
                fallthrough            = optional(bool, false)
                fallthrough_zones      = optional(list(string), [])
                ignore_empty_service   = optional(bool, false)
                multicluster_zones     = optional(list(string), [])
                zonal                  = optional(bool, false)
                startup_timeout        = optional(string, "")
            })
            default = null
        }
        file = {
            description = "Configures authoritative RFC 1035 zone files on the primary server block."
            type = list(object({
                dbfile            = string
                zones             = optional(list(string), [])
                reload            = optional(string, "")
                fallthrough       = optional(bool, false)
                fallthrough_zones = optional(list(string), [])
            }))
            default = []
        }
        auto = {
            description = "Configures automatic loading of RFC 1035 zone files from directories on the primary server block."
            type = list(object({
                zones           = optional(list(string), [])
                directory       = string
                regexp          = optional(string, "")
                origin_template = optional(string, "")
                reload          = optional(string, "")
            }))
            default = []
        }
        secondary = {
            description = "Configures secondary AXFR zone transfers and RFC 9432 catalog zones on the primary server block."
            type = list(object({
                zones                = optional(list(string), [])
                transfer_from        = optional(list(string), [])
                catalog              = optional(bool, false)
                catalog_member_zones = optional(list(string), [])
                fallthrough          = optional(bool, false)
                fallthrough_zones    = optional(list(string), [])
            }))
            default = []
        }
        etcd = {
            description = "Configures SkyDNS service discovery backed by etcd3 on the primary server block."
            type = object({
                zones             = optional(list(string), [])
                fallthrough       = optional(bool, false)
                fallthrough_zones = optional(list(string), [])
                path              = optional(string, "")
                endpoints         = optional(list(string), [])
                username          = optional(string, "")
                password          = optional(string, "")
                tls_cert          = optional(string, "")
                tls_key           = optional(string, "")
                tls_cacert        = optional(string, "")
                no_apex_fallback  = optional(bool, false)
                min_lease_ttl     = optional(string, "")
                max_lease_ttl     = optional(string, "")
            })
            default = null
        }
        loop = {
            description = "Enables forwarding loop detection on the primary server block."
            type        = bool
            default     = false
        }
        grpc = {
            description = "Configures proxying DNS messages to upstream resolvers over gRPC on the primary server block."
            type = object({
                from              = optional(string, ".")
                to                = list(string)
                except            = optional(list(string), [])
                tls_cert          = optional(string, "")
                tls_key           = optional(string, "")
                tls_ca            = optional(string, "")
                tls_servername    = optional(string, "")
                policy            = optional(string, "")
                fallthrough       = optional(bool, false)
                fallthrough_zones = optional(list(string), [])
            })
            default = null
        }
        erratic = {
            description = "Configures synthetic delayed, dropped, or truncated responses for client testing on the primary server block."
            type = object({
                enabled        = optional(bool, true)
