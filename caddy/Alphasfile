package "caddy" {
    features = {
        dns = {
            description = "Starts local CoreDNS for the configured domain and adds /dns/healthz resolved through CoreDNS."
        }
        tls = {
            description = "Enables internal TLS certificates (local_certs) and HTTPS listeners for sites."
        }
        trust = {
            description = "Allows Caddy to install its local Root CA into the system trust store."
        }
        admin = {
            description = "Enables the Caddy administration API endpoint on 127.0.0.1:<admin_port>."
        }
        metrics = {
            description = "Enables global Prometheus and OpenTelemetry metrics collection and exposes /metrics."
        }
        debug = {
            description = "Enables global debug logging mode."
        }
        log = {
            description = "Enables structured access logging across all configured sites."
        }
        watch = {
            description = "Watches the generated Caddyfile for changes and reloads automatically (--watch)."
        }
        encode = {
            description = "Enables zstd and gzip response compression across all configured sites."
        }
    }

    outputs = {
        domain = {
            description = "Base domain suffix configured for Caddy sites."
            type        = string
            value       = inputs.domain
        }
        http_port = {
            description = "HTTP port Caddy listens on."
            type        = number
            value       = component.caddy.service.go.caddy.vars.http
        }
        https_port = {
            description = "HTTPS port Caddy listens on."
            type        = number
            value       = component.caddy.service.go.caddy.vars.https
        }
        admin_port = {
            description = "Port for the Caddy administration API endpoint."
            type        = number
            value       = component.caddy.service.go.caddy.vars.admin
        }
        url = {
            description = "Base loopback URL where Caddy serves HTTP."
            type        = string
            value       = "http://127.0.0.1:${component.caddy.service.go.caddy.vars.http}"
        }
        http_url = {
            description = "HTTP URL for the base domain."
            type        = string
            value       = "http://${inputs.domain}:${component.caddy.service.go.caddy.vars.http}"
        }
        https_url = {
            description = "HTTPS URL for the base domain."
            type        = string
            value       = "https://${inputs.domain}:${component.caddy.service.go.caddy.vars.https}"
        }
        admin_url = {
            description = "HTTP URL of the Caddy administration API endpoint."
            type        = string
            value       = "http://127.0.0.1:${component.caddy.service.go.caddy.vars.admin}"
        }
        health_url = {
            description = "HTTP URL of the Caddy readiness endpoint."
            type        = string
            value       = "http://127.0.0.1:${component.caddy.service.go.caddy.vars.http}${inputs.health_path}"
        }
        caddyfile = {
            description = "Filesystem path to the generated Caddyfile."
            type        = string
            value       = component.caddy.service.go.caddy.file.caddyfile.path
        }
        ready = {
            description = "Readiness barrier reference for the Caddy service."
            type        = string
            value       = component.caddy.service.go.caddy.runtime.ready
        }
    }

    import "github.com/zordon-io/zordon-modules/coredns" {
        enabled = features.dns
        inputs = {
            zone     = inputs.domain
            dns_port = inputs.dns_port
            hosts    = inputs.dns_hosts
            records  = inputs.dns_records
            forwards = inputs.dns_forwards
        }
    }

    inputs = {
        # =====================================================================
        # CLI Flags (caddy run)
        # =====================================================================
        adapter = {
            type        = string
            default     = "caddyfile"
            description = "Configuration adapter name passed to caddy run --adapter"
        }
        environ = {
            type        = bool
            default     = false
            description = "Print process environment before starting (--environ)"
        }
        resume = {
            type        = bool
            default     = false
            description = "Prefer saved autosave config over --config file (--resume)"
        }
        watch = {
            type        = bool
            default     = false
            description = "Watch config file and reload automatically on change (--watch)"
        }
        pidfile = {
            type        = string
            default     = ""
            description = "Path of file to write process ID (--pidfile)"
        }
        pingback = {
            type        = string
            default     = ""
            description = "Address to echo confirmation bytes to on startup (--pingback)"
        }

        # =====================================================================
        # Core Listener, Readiness & DNS Integration
        # =====================================================================
        domain = {
            type        = string
            default     = "test"
            description = "Base domain suffix for site hostnames (<site>.<domain>)"
        }
        http_port = {
            type        = number
            default     = null
            description = "Global HTTP port (http_port); null picks a free port automatically."
        }
        https_port = {
            type        = number
            default     = null
            description = "Global HTTPS port (https_port); null picks a free port automatically."
        }
        admin_port = {
            type        = number
            default     = null
            description = "Port for the Caddy admin API listener; null picks a free port automatically."
        }
        health_path = {
            type        = string
            default     = "/healthz"
            description = "HTTP path served on health_port for readiness probes"
        }
        dns_port = {
            type        = number
            default     = null
            description = "Optional DNS port override forwarded to the coredns module"
        }
        dns_hosts = {
            type = map(object({
                ip        = string
                hostnames = optional(list(string), [])
            }))
            default     = {}
            description = "Additional static DNS host mappings forwarded to the coredns module"
        }
        dns_records = {
            type = map(object({
                name  = string
                type  = optional(string, "A")
                class = optional(string, "IN")
                ttl   = optional(number, 60)
                data  = string
            }))
            default     = {}
            description = "Additional DNS resource records forwarded to the coredns module"
        }
        dns_forwards = {
            type = map(object({
                from                             = optional(string, ".")
                to                               = list(string)
                except                           = optional(list(string), [])
                force_tcp                        = optional(bool, false)
                prefer_udp                       = optional(bool, false)
                expire                           = optional(string, "")
                max_fails                        = optional(number)
                tls_cert                         = optional(string, "")
                tls_key                          = optional(string, "")
                tls_ca                           = optional(string, "")
                tls_servername                   = optional(string, "")
                policy                           = optional(string, "")
                health_check                     = optional(string, "")
                health_check_domain              = optional(string, "")
                dnstap                           = optional(bool, false)
                max_concurrent                   = optional(number)
                next                             = optional(list(string), [])
                failfast_all_unhealthy_upstreams = optional(bool, false)
                failovers                        = optional(list(string), [])
            }))
            default     = {}
            description = "Upstream DNS forwarders forwarded to the coredns module"
        }

        # =====================================================================
        # Caddyfile Global Options Block ({ ... })
        # =====================================================================
        debug = {
            type        = bool
            default     = false
            description = "Enable debug mode in the global options block"
        }
        default_bind = {
            type = object({
                addresses = optional(list(string), ["127.0.0.1"])
                protocols = optional(list(string), [])
            })
            default     = null
            description = "Default bind addresses and protocols for all servers (default_bind)"
        }
        grace_period = {
            type        = string
            default     = ""
            description = "Duration of graceful shutdown period (grace_period)"
        }
        shutdown_delay = {
            type        = string
            default     = ""
            description = "Duration to delay before beginning shutdown (shutdown_delay)"
        }
        default_sni = {
            type        = string
            default     = ""
            description = "Default ServerName when client does not use SNI (default_sni)"
        }
        fallback_sni = {
            type        = string
            default     = ""
            description = "Fallback ServerName when SNI does not match any certificate (fallback_sni)"
        }
        order = {
            type = list(object({
                directive = string
                position  = string
                target    = optional(string, "")
            }))
            default     = []
            description = "Custom HTTP handler directive ordering rules (order <dir> first|last|before|after [<target>])"
        }
        storage_root = {
            type        = string
            default     = ""
            description = "Root directory for file_system storage (defaults to Zordon service var directory)"
        }
        storage_check = {
            type        = string
            default     = ""
            description = "Set to 'off' to disable storage permission checks (storage_check)"
        }
        storage_clean_interval = {
            type        = string
            default     = ""
            description = "How often to scan storage for expired assets, or 'off' (storage_clean_interval)"
        }
        renew_interval = {
            type        = string
            default     = ""
            description = "How often to scan certificates for renewal (renew_interval)"
        }
        ocsp_interval = {
            type        = string
            default     = ""
            description = "How often to check OCSP staples for updates (ocsp_interval)"
        }
        acme_ca = {
            type        = string
            default     = ""
            description = "ACME directory endpoint URL (acme_ca)"
        }
        acme_ca_root = {
            type        = string
            default     = ""
            description = "PEM file containing trusted root CA for ACME endpoint (acme_ca_root)"
        }
        acme_eab = {
            type = object({
                key_id  = string
                mac_key = string
            })
            default     = null
            description = "External Account Binding credentials for ACME (acme_eab)"
        }
        skip_install_trust = {
            type        = bool
            default     = true
            description = "Skip installing local CA root certificates into system trust store (skip_install_trust)"
        }
        email = {
            type        = string
            default     = ""
            description = "Email address for ACME account registration (email)"
        }
        admin = {
            type = object({
                enabled        = optional(bool, true)
                listen         = optional(string, "")
                enforce_origin = optional(bool, false)
                origins        = optional(list(string), [])
            })
            default     = null
            description = "Global admin API configuration (admin)"
        }
        on_demand_tls = {
            type = object({
                ask               = optional(string, "")
                permission_module = optional(string, "")
            })
            default     = null
            description = "Global On-Demand TLS configuration (on_demand_tls)"
        }
        local_certs = {
            type        = bool
            default     = false
            description = "Use internal CA for all managed certificates by default (local_certs)"
        }
        key_type = {
            type        = string
            default     = ""
            description = "Default key type for TLS certificates: ed25519, p256, p384, rsa2048, rsa4096 (key_type)"
        }
        auto_https = {
            type        = list(string)
            default     = []
            description = "Auto-HTTPS options: off, disable_redirects, disable_certs, ignore_loaded_certs (auto_https)"
        }
        metrics = {
            type = object({
                enabled                = optional(bool, true)
                per_host               = optional(bool, false)
                observe_catchall_hosts = optional(bool, false)
                otlp                   = optional(bool, false)
                path                   = optional(string, "/metrics")
                disable_openmetrics    = optional(bool, false)
            })
            default     = null
            description = "Global metrics configuration and health-server metrics endpoint"
        }
        servers_options = {
            type = list(object({
                listener_address                = optional(string, "")
                name                            = optional(string, "")
                read_body                       = optional(string, "")
                read_body_idle                  = optional(string, "")
                read_header                     = optional(string, "")
                write                           = optional(string, "")
                write_idle                      = optional(string, "")
                write_max_chunk                 = optional(string, "")
                idle                            = optional(string, "")
                keepalive_interval              = optional(string, "")
                keepalive_idle                  = optional(string, "")
                keepalive_count                 = optional(number)
                max_header_size                 = optional(string, "")
                enable_full_duplex              = optional(bool, false)
                expected_underscore_headers     = optional(list(string), [])
                expected_dot_headers            = optional(list(string), [])
                log_credentials                 = optional(bool, false)
                protocols                       = optional(list(string), [])
                strict_sni_host                 = optional(bool)
                trusted_proxies                 = optional(list(string), [])
                trusted_proxies_private_ranges  = optional(bool, false)
                trusted_proxies_strict          = optional(bool, false)
                trusted_proxies_unix            = optional(bool, false)
                client_ip_headers               = optional(list(string), [])
                trace                           = optional(bool, false)
                allow_0rtt                      = optional(bool)
                listener_wrappers               = optional(list(string), [])
                packet_conn_wrappers            = optional(list(string), [])
            }))
            default     = []
            description = "Global HTTP server listener overrides (servers)"
        }
        ocsp_stapling_off = {
            type        = bool
            default     = false
            description = "Disable OCSP stapling globally (ocsp_stapling off)"
        }
        cert_lifetime = {
            type        = string
            default     = ""
            description = "Default ACME certificate validity duration (cert_lifetime)"
        }
        log = {
            type = map(object({
                output              = optional(string, "")
                file_roll_size      = optional(string, "")
                file_roll_keep      = optional(number)
                file_roll_keep_for  = optional(string, "")
                format              = optional(string, "")
                level               = optional(string, "")
                include             = optional(list(string), [])
                exclude             = optional(list(string), [])
                sampling_interval   = optional(string, "")
                sampling_first      = optional(number)
                sampling_thereafter = optional(number)
            }))
            default     = {}
            description = "Global named loggers configuration (use key 'default' for the default logger)"
        }
        preferred_chains = {
            type = object({
                smallest         = optional(bool, false)
                root_common_name = optional(list(string), [])
                any_common_name  = optional(list(string), [])
            })
            default     = null
            description = "Global preferred ACME certificate chain selection criteria (preferred_chains)"
        }
        persist_config_off = {
            type        = bool
            default     = false
            description = "Disable persisting active configuration to disk (persist_config off)"
        }
        tls_resolvers = {
            type        = list(string)
            default     = []
            description = "Global DNS resolvers for TLS ACME challenges (tls_resolvers)"
        }
        tls_automate_names = {
            type        = list(string)
            default     = []
            description = "Domain names to automate certificates for globally (tls_automate_names)"
        }
        renewal_window_ratio = {
            type        = number
            default     = null
            description = "Fraction of certificate lifetime remaining before renewal (renewal_window_ratio)"
        }
        pki = {
            type = map(object({
                name                  = optional(string, "")
                root_cn               = optional(string, "")
                intermediate_cn       = optional(string, "")
                intermediate_lifetime = optional(string, "")
                maintenance_interval  = optional(string, "")
                renewal_window_ratio  = optional(number)
                root_cert             = optional(string, "")
                root_key              = optional(string, "")
                root_format           = optional(string, "")
                intermediate_cert     = optional(string, "")
                intermediate_key      = optional(string, "")
                intermediate_format   = optional(string, "")
            }))
            default     = {}
            description = "Global PKI Certificate Authorities keyed by CA ID (pki { ca <id> { ... } })"
        }
        events = {
            type = list(object({
                event   = string
                handler = string
            }))
            default     = []
            description = "Global event subscriptions (events { on <event> <handler> })"
        }
        filesystems = {
            type        = map(string)
            default     = {}
            description = "Global filesystem module registrations keyed by name (filesystem <name> <module>)"
        }

        # =====================================================================
        # Reusable Snippets & Named Routes
        # =====================================================================
        snippets = {
            type        = map(string)
            default     = {}
            description = "Reusable Caddyfile snippets keyed by snippet name: (name) { ... }"
        }
        named_routes = {
            type        = map(string)
            default     = {}
            description = "Reusable named routes keyed by route name: &(name) { ... } (invoked via invoke <name>)"
        }

        # =====================================================================
        # Sites & Full Directive Layer
        # =====================================================================
        sites = {
            type = map(object({
                # Shorthand reverse-proxy attributes (backwards-compatible with simple Caddy module)
                host          = optional(string, "")
                upstream      = optional(string, "")
                upstream_port = optional(number)
                upstreams     = optional(list(string), [])
                path_prefix   = optional(string, "")

                # Site addresses, bind & snippet imports
                addresses      = optional(list(string), [])
                bind           = optional(list(string), ["127.0.0.1"])
                bind_protocols = optional(list(string), [])
                imports        = optional(list(string), [])

                # Named request matchers (@<name>)
                matchers = optional(map(object({
                    expression      = optional(string, "")
                    host            = optional(list(string), [])
                    path            = optional(list(string), [])
                    path_regexp     = optional(string, "")
                    method          = optional(list(string), [])
                    query           = optional(map(list(string)), {})
                    header          = optional(map(list(string)), {})
                    header_regexp   = optional(map(string), {})
                    protocol        = optional(string, "")
                    remote_ip       = optional(list(string), [])
                    client_ip       = optional(list(string), [])
                    vars            = optional(map(list(string)), {})
                    vars_regexp     = optional(map(string), {})
                    file_try_files  = optional(list(string), [])
                    file_try_policy = optional(string, "")
                    file_split_path = optional(list(string), [])
                    not_path        = optional(list(string), [])
                    not_method      = optional(list(string), [])
                    not_remote_ip   = optional(list(string), [])
                })), {})

                # TLS directive (tls)
                tls = optional(object({
                    internal                      = optional(bool, false)
                    email                         = optional(string, "")
                    force_automate                = optional(bool, false)
                    cert_file                     = optional(string, "")
                    key_file                      = optional(string, "")
                    protocols_min                 = optional(string, "")
                    protocols_max                 = optional(string, "")
                    ciphers                       = optional(list(string), [])
                    curves                        = optional(list(string), [])
                    alpn                          = optional(list(string), [])
                    load_folders                  = optional(list(string), [])
                    ca                            = optional(string, "")
                    ca_root                       = optional(string, "")
                    key_type                      = optional(string, "")
                    dns_provider                  = optional(string, "")
                    propagation_delay             = optional(string, "")
                    propagation_timeout           = optional(string, "")
                    resolvers                     = optional(list(string), [])
                    dns_ttl                       = optional(string, "")
                    dns_challenge_override_domain = optional(string, "")
                    on_demand                     = optional(bool, false)
                    reuse_private_keys            = optional(bool, false)
                    eab_key_id                    = optional(string, "")
                    eab_mac_key                   = optional(string, "")
                    insecure_secrets_log          = optional(string, "")
                    renewal_window_ratio          = optional(number)
                    client_auth = optional(object({
                        mode                    = optional(string, "")
                        trusted_ca_cert_files   = optional(list(string), [])
                        trusted_leaf_cert_files = optional(list(string), [])
                    }))
                }))

                # Filesystem, root, vars & map directives
                fs   = optional(string, "")
                root = optional(string, "")
                vars = optional(map(string), {})
                maps = optional(list(object({
                    matcher      = optional(string, "")
                    source       = string
                    destinations = list(string)
                    mappings     = map(list(string))
                    defaults     = optional(list(string), [])
                })), [])

                # Logging directives (log, log_skip, log_name, log_append)
                log = optional(object({
                    enabled             = optional(bool, true)
                    name                = optional(string, "")
                    hostnames           = optional(list(string), [])
                    no_hostname         = optional(bool, false)
                    output              = optional(string, "")
                    format              = optional(string, "")
                    level               = optional(string, "")
                    sampling_interval   = optional(string, "")
                    sampling_first      = optional(number)
                    sampling_thereafter = optional(number)
                }))
                log_skip = optional(list(string), [])
                log_name = optional(list(string), [])
                log_append = optional(list(object({
                    matcher = optional(string, "")
                    key     = string
                    value   = string
                    early   = optional(bool, false)
                })), [])

                # Headers, request_body & timeouts directives
                headers = optional(list(object({
                    matcher = optional(string, "")
                    set     = optional(map(string), {})
                    add     = optional(map(string), {})
                    default = optional(map(string), {})
                    delete  = optional(list(string), [])
                    replace = optional(list(object({
                        field       = string
                        search      = string
                        replacement = string
                    })), [])
                    defer = optional(bool, false)
                })), [])
                request_headers = optional(list(object({
                    matcher = optional(string, "")
                    set     = optional(map(string), {})
                    add     = optional(map(string), {})
                    delete  = optional(list(string), [])
                    replace = optional(list(object({
                        field       = string
                        search      = string
                        replacement = string
                    })), [])
                })), [])
                request_body = optional(object({
                    matcher  = optional(string, "")
                    max_size = optional(string, "")
                }))
                timeouts = optional(object({
                    matcher         = optional(string, "")
                    read_timeout    = optional(string, "")
                    write_timeout   = optional(string, "")
                    max_write_chunk = optional(number)
                }))

                # Redirects, method, rewrite, uri & try_files directives
                redirects = optional(list(object({
                    matcher = optional(string, "")
                    to      = string
                    code    = optional(string, "")
                })), [])
                methods = optional(list(object({
                    matcher = optional(string, "")
                    method  = string
                })), [])
                rewrites = optional(list(object({
                    matcher = optional(string, "")
                    to      = string
                })), [])
                uris = optional(list(object({
                    matcher     = optional(string, "")
                    op          = string
                    target      = string
                    replacement = optional(string, "")
                    limit       = optional(number)
                })), [])
                try_files = optional(object({
                    files  = list(string)
                    policy = optional(string, "")
                }))

                # Authentication directives (basic_auth, forward_auth)
                basic_auth = optional(list(object({
                    matcher        = optional(string, "")
                    hash_algorithm = optional(string, "")
                    realm          = optional(string, "")
                    users          = map(string)
                })), [])
                forward_auth = optional(list(object({
                    matcher                  = optional(string, "")
                    upstreams                = list(string)
                    uri                      = string
                    copy_headers             = optional(list(string), [])
                    header_up                = optional(map(string), {})
                    tls_insecure_skip_verify = optional(bool, false)
                })), [])

                # Middleware directives (encode, push, templates, tracing, intercept, invoke)
                encode = optional(object({
                    matcher               = optional(string, "")
                    formats               = optional(list(string), ["zstd", "gzip"])
                    gzip_level            = optional(number)
                    zstd_level            = optional(string, "")
                    zstd_disable_checksum = optional(bool, false)
                    minimum_length        = optional(number)
                    match_status          = optional(list(string), [])
                    match_headers         = optional(map(string), {})
                }))
                push = optional(object({
                    matcher        = optional(string, "")
                    resources      = optional(list(string), [])
                    headers_set    = optional(map(string), {})
                    headers_delete = optional(list(string), [])
                }))
                templates = optional(object({
                    matcher       = optional(string, "")
                    mime          = optional(list(string), [])
                    between_open  = optional(string, "")
                    between_close = optional(string, "")
                    root          = optional(string, "")
                    extensions    = optional(list(string), [])
                }))
                tracing = optional(object({
                    matcher         = optional(string, "")
                    span            = string
                    span_attributes = optional(map(string), {})
                }))
                intercept = optional(object({
                    matcher = optional(string, "")
                    replace_status = optional(list(object({
                        matcher     = optional(string, "")
                        status_code = number
                    })), [])
                }))
                invoke = optional(list(object({
                    matcher = optional(string, "")
                    name    = string
                })), [])

                # Full reverse_proxy configuration
                reverse_proxy = optional(object({
                    matcher = optional(string, "")
                    to      = optional(list(string), [])
                    dynamic_srv = optional(object({
                        service             = optional(string, "")
                        proto               = optional(string, "")
                        name                = optional(string, "")
                        refresh             = optional(string, "")
                        resolvers           = optional(list(string), [])
                        dial_timeout        = optional(string, "")
                        dial_fallback_delay = optional(string, "")
                        grace_period        = optional(string, "")
                    }))
                    dynamic_a = optional(object({
                        name                = string
                        port                = string
                        refresh             = optional(string, "")
                        resolvers           = optional(list(string), [])
                        dial_timeout        = optional(string, "")
                        dial_fallback_delay = optional(string, "")
                        ipv4                = optional(bool, false)
                        ipv6                = optional(bool, false)
                    }))
                    lb_policy                      = optional(string, "")
                    lb_retries                     = optional(number)
                    lb_try_duration                = optional(string, "")
                    lb_try_interval                = optional(string, "")
                    lb_retry_match                 = optional(string, "")
                    health_uri                     = optional(string, "")
                    health_port                    = optional(number)
                    health_interval                = optional(string, "")
                    health_passes                  = optional(number)
                    health_fails                   = optional(number)
                    health_timeout                 = optional(string, "")
                    health_status                  = optional(string, "")
