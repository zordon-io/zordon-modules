                    respond_status   = optional(number)
                    rewrite_to       = optional(string, "")
                    file_server      = optional(bool, false)
                    reverse_proxy_to = optional(list(string), [])
                    headers_set      = optional(map(string), {})
                })), [])
                extra_directives = optional(list(string), [])
            }))
            default     = {}
            description = "Map of site blocks keyed by subdomain/site name"
        }
    }

    component "caddy" {
        toolchain {
            go {
                version = "1.26.0"
            }
        }

        service "go" "caddy" {
            git {
                url = "github.com/caddyserver/caddy"
