            first ${lg.sampling_first}
%{endif ~}
%{if lg.sampling_thereafter != null ~}
            thereafter ${lg.sampling_thereafter}
%{endif ~}
        }
%{endif ~}
    }
%{endfor ~}
%{if inputs.preferred_chains != null ~}
%{if inputs.preferred_chains.smallest ~}
    preferred_chains smallest
%{else ~}
    preferred_chains {
%{if [for cn in inputs.preferred_chains.root_common_name : cn] != [] ~}
        root_common_name%{for cn in inputs.preferred_chains.root_common_name} "${cn}"%{endfor}
%{endif ~}
%{if [for cn in inputs.preferred_chains.any_common_name : cn] != [] ~}
        any_common_name%{for cn in inputs.preferred_chains.any_common_name} "${cn}"%{endfor}
%{endif ~}
    }
%{endif ~}
%{endif ~}
%{if inputs.persist_config_off ~}
    persist_config off
%{endif ~}
%{if [for r in inputs.tls_resolvers : r] != [] ~}
    tls_resolvers%{for r in inputs.tls_resolvers} ${r}%{endfor}
%{endif ~}
%{if [for n in inputs.tls_automate_names : n] != [] ~}
    tls_automate_names%{for n in inputs.tls_automate_names} ${n}%{endfor}
%{endif ~}
%{if inputs.renewal_window_ratio != null ~}
    renewal_window_ratio ${inputs.renewal_window_ratio}
%{endif ~}
%{if [for _, ca in inputs.pki : ca] != [] ~}
    pki {
%{for ca_id, ca in inputs.pki ~}
        ca ${ca_id} {
%{if ca.name != "" ~}
            name "${ca.name}"
%{endif ~}
%{if ca.root_cn != "" ~}
            root_cn "${ca.root_cn}"
%{endif ~}
%{if ca.intermediate_cn != "" ~}
            intermediate_cn "${ca.intermediate_cn}"
%{endif ~}
%{if ca.intermediate_lifetime != "" ~}
            intermediate_lifetime ${ca.intermediate_lifetime}
%{endif ~}
%{if ca.maintenance_interval != "" ~}
            maintenance_interval ${ca.maintenance_interval}
%{endif ~}
%{if ca.renewal_window_ratio != null ~}
            renewal_window_ratio ${ca.renewal_window_ratio}
%{endif ~}
%{if ca.root_cert != "" || ca.root_key != "" || ca.root_format != "" ~}
            root {
%{if ca.root_cert != "" ~}
                cert ${ca.root_cert}
%{endif ~}
%{if ca.root_key != "" ~}
                key ${ca.root_key}
%{endif ~}
%{if ca.root_format != "" ~}
                format ${ca.root_format}
%{endif ~}
            }
%{endif ~}
%{if ca.intermediate_cert != "" || ca.intermediate_key != "" || ca.intermediate_format != "" ~}
            intermediate {
%{if ca.intermediate_cert != "" ~}
                cert ${ca.intermediate_cert}
%{endif ~}
%{if ca.intermediate_key != "" ~}
                key ${ca.intermediate_key}
%{endif ~}
%{if ca.intermediate_format != "" ~}
                format ${ca.intermediate_format}
%{endif ~}
            }
%{endif ~}
        }
%{endfor ~}
    }
%{endif ~}
%{if [for ev in inputs.events : ev] != [] ~}
    events {
%{for ev in inputs.events ~}
        on ${ev.event} ${ev.handler}
%{endfor ~}
    }
%{endif ~}
%{for fs_name, fs_mod in inputs.filesystems ~}
    filesystem ${fs_name} ${fs_mod}
%{endfor ~}
}
%{for snippet_name, snippet_body in inputs.snippets ~}

(${snippet_name}) {
    ${snippet_body}
}
%{endfor ~}
%{for route_name, route_body in inputs.named_routes ~}

&(${route_name}) {
    ${route_body}
}
%{endfor ~}

:${self.vars.http} {
    bind 127.0.0.1
    respond ${inputs.health_path} "ok" 200
%{if features.metrics || (inputs.metrics != null && inputs.metrics.enabled) ~}
    metrics ${inputs.metrics != null ? inputs.metrics.path : "/metrics"}%{if inputs.metrics != null && inputs.metrics.disable_openmetrics} {
        disable_openmetrics
    }%{endif}
%{endif ~}
    import ${fs::etc()}/sites/*.caddy
}
%{for name, site in inputs.sites ~}

%{if [for addr in site.addresses : addr] != [] ~}
%{for i, addr in site.addresses}${i > 0 ? ", " : ""}${addr}%{endfor} {
%{else ~}
${features.tls || inputs.local_certs || site.tls != null ? "https://${site.host != "" ? site.host : "${name}.${inputs.domain}"}:${self.vars.https}, " : ""}http://${site.host != "" ? site.host : "${name}.${inputs.domain}"}:${self.vars.http} {
%{endif ~}
%{if [for b in site.bind : b] != [] ~}
%{if [for p in site.bind_protocols : p] != [] ~}
