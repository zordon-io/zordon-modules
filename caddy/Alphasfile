                    headers_set      = optional(map(string), {})
                })), [])
                handle_paths = optional(list(object({
                    path             = string
                    reverse_proxy_to = optional(list(string), [])
                    rewrite_to       = optional(string, "")
                    root             = optional(string, "")
                    file_server      = optional(bool, false)
                    respond_body     = optional(string, "")
                    respond_status   = optional(number)
                    redir_to         = optional(string, "")
                    redir_code       = optional(string, "")
                    headers_set      = optional(map(string), {})
                })), [])
                routes = optional(list(object({
                    matcher          = optional(string, "")
                    reverse_proxy_to = optional(list(string), [])
                    strip_prefix     = optional(string, "")
                    rewrite_to       = optional(string, "")
                    root             = optional(string, "")
                    file_server      = optional(bool, false)
                    respond_body     = optional(string, "")
                    respond_status   = optional(number)
                    redir_to         = optional(string, "")
                    redir_code       = optional(string, "")
                    headers_set      = optional(map(string), {})
                })), [])
                handle_errors = optional(list(object({
                    status_codes     = optional(list(string), [])
