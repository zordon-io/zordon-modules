                })), [])

                # PHP FastCGI (php_fastcgi)
                php_fastcgi = optional(object({
                    matcher              = optional(string, "")
                    upstreams            = list(string)
                    root                 = optional(string, "")
                    split                = optional(string, "")
                    env                  = optional(map(string), {})
                    index                = optional(string, "")
                    try_files            = optional(list(string), [])
                    resolve_root_symlink = optional(bool, false)
                    dial_timeout         = optional(string, "")
                    read_timeout         = optional(string, "")
                    write_timeout        = optional(string, "")
                    capture_stderr       = optional(bool, false)
                }))

                # Static file server (file_server)
                file_server = optional(object({
                    enabled                = optional(bool, true)
                    matcher                = optional(string, "")
                    browse                 = optional(bool, false)
                    browse_template        = optional(string, "")
                    fs                     = optional(string, "")
                    root                   = optional(string, "")
