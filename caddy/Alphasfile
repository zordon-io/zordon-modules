            }

            print = "http://127.0.0.1:${self.vars.http}/  (caddy)%{for name, s in inputs.sites} ${features.tls || inputs.local_certs || s.tls != null ? "https" : "http"}://${s.host != "" ? s.host : "${name}.${inputs.domain}"}:${features.tls || inputs.local_certs || s.tls != null ? self.vars.https : self.vars.http}/%{endfor}"

