                    precompressed          = optional(list(string), [])
                    status                 = optional(string, "")
                    disable_canonical_uris = optional(bool, false)
                    pass_thru              = optional(bool, false)
                    etag_file_extensions   = optional(list(string), [])
                }))

                # Responders, errors, aborts, metrics & acme_server
                responds = optional(list(object({
                    matcher = optional(string, "")
                    body    = optional(string, "")
                    status  = optional(number)
                    close   = optional(bool, false)
                })), [])
                errors = optional(list(object({
                    matcher = optional(string, "")
                    message = optional(string, "")
                    status  = optional(number)
                })), [])
                aborts = optional(list(string), [])
                metrics = optional(object({
                    enabled             = optional(bool, true)
                    matcher             = optional(string, "")
                    disable_openmetrics = optional(bool, false)
                }))
                acme_server = optional(object({
                    matcher              = optional(string, "")
                    ca                   = optional(string, "")
