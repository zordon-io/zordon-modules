                    deny_ip_ranges       = optional(list(string), [])
                    sign_with_root       = optional(bool, false)
                }))

                # Subroutes: handle, handle_path, route, handle_errors
                handles = optional(list(object({
                    matcher          = optional(string, "")
                    reverse_proxy_to = optional(list(string), [])
                    strip_prefix     = optional(string, "")
                    rewrite_to       = optional(string, "")
                    root             = optional(string, "")
                    file_server      = optional(bool, false)
