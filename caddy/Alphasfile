        permission ${inputs.on_demand_tls.permission_module}
%{endif ~}
    }
%{endif ~}
%{if features.tls || inputs.local_certs ~}
    local_certs
%{endif ~}
%{if inputs.key_type != "" ~}
    key_type ${inputs.key_type}
%{endif ~}
%{if [for opt in inputs.auto_https : opt] != [] ~}
    auto_https%{for opt in inputs.auto_https} ${opt}%{endfor}
%{else ~}
%{if !features.tls && !inputs.local_certs ~}
    auto_https off
%{endif ~}
%{endif ~}
%{if features.metrics || (inputs.metrics != null && inputs.metrics.enabled) ~}
    metrics {
%{if inputs.metrics != null && inputs.metrics.per_host ~}
        per_host
%{endif ~}
%{if inputs.metrics != null && inputs.metrics.observe_catchall_hosts ~}
        observe_catchall_hosts
%{endif ~}
%{if inputs.metrics != null && inputs.metrics.otlp ~}
        otlp
%{endif ~}
    }
%{endif ~}
%{for srv_opt in inputs.servers_options ~}
    servers${srv_opt.listener_address != "" ? " ${srv_opt.listener_address}" : ""} {
%{if srv_opt.name != "" ~}
        name ${srv_opt.name}
%{endif ~}
%{if [for w in srv_opt.listener_wrappers : w] != [] ~}
        listener_wrappers {
%{for w in srv_opt.listener_wrappers ~}
            ${w}
%{endfor ~}
        }
%{endif ~}
%{if [for w in srv_opt.packet_conn_wrappers : w] != [] ~}
        packet_conn_wrappers {
%{for w in srv_opt.packet_conn_wrappers ~}
            ${w}
%{endfor ~}
        }
%{endif ~}
%{if srv_opt.read_body != "" || srv_opt.read_body_idle != "" || srv_opt.read_header != "" || srv_opt.write != "" || srv_opt.write_idle != "" || srv_opt.write_max_chunk != "" || srv_opt.idle != "" ~}
        timeouts {
%{if srv_opt.read_body != "" ~}
            read_body ${srv_opt.read_body}
%{endif ~}
%{if srv_opt.read_body_idle != "" ~}
            read_body_idle ${srv_opt.read_body_idle}
%{endif ~}
%{if srv_opt.read_header != "" ~}
            read_header ${srv_opt.read_header}
%{endif ~}
%{if srv_opt.write != "" ~}
            write ${srv_opt.write}
%{endif ~}
%{if srv_opt.write_idle != "" ~}
            write_idle ${srv_opt.write_idle}
%{endif ~}
%{if srv_opt.write_max_chunk != "" ~}
            write_max_chunk ${srv_opt.write_max_chunk}
%{endif ~}
%{if srv_opt.idle != "" ~}
            idle ${srv_opt.idle}
%{endif ~}
        }
%{endif ~}
%{if srv_opt.keepalive_interval != "" ~}
        keepalive_interval ${srv_opt.keepalive_interval}
%{endif ~}
%{if srv_opt.keepalive_idle != "" ~}
        keepalive_idle ${srv_opt.keepalive_idle}
%{endif ~}
%{if srv_opt.keepalive_count != null ~}
        keepalive_count ${srv_opt.keepalive_count}
%{endif ~}
%{if srv_opt.max_header_size != "" ~}
        max_header_size ${srv_opt.max_header_size}
%{endif ~}
%{if srv_opt.enable_full_duplex ~}
        enable_full_duplex
%{endif ~}
%{if [for h in srv_opt.expected_underscore_headers : h] != [] ~}
        expected_underscore_headers%{for h in srv_opt.expected_underscore_headers} ${h}%{endfor}
%{endif ~}
%{if [for h in srv_opt.expected_dot_headers : h] != [] ~}
        expected_dot_headers%{for h in srv_opt.expected_dot_headers} ${h}%{endfor}
%{endif ~}
%{if srv_opt.log_credentials ~}
        log_credentials
%{endif ~}
%{if [for p in srv_opt.protocols : p] != [] ~}
        protocols%{for p in srv_opt.protocols} ${p}%{endfor}
%{endif ~}
%{if srv_opt.strict_sni_host != null ~}
        strict_sni_host ${srv_opt.strict_sni_host ? "" : "off"}
%{endif ~}
%{if srv_opt.trusted_proxies_private_ranges || [for r in srv_opt.trusted_proxies : r] != [] ~}
        trusted_proxies static${srv_opt.trusted_proxies_private_ranges ? " private_ranges" : ""}%{for r in srv_opt.trusted_proxies} ${r}%{endfor}
%{endif ~}
%{if srv_opt.trusted_proxies_strict ~}
        trusted_proxies_strict
%{endif ~}
%{if srv_opt.trusted_proxies_unix ~}
        trusted_proxies_unix
%{endif ~}
%{if [for h in srv_opt.client_ip_headers : h] != [] ~}
        client_ip_headers%{for h in srv_opt.client_ip_headers} ${h}%{endfor}
%{endif ~}
%{if srv_opt.trace ~}
        trace
%{endif ~}
%{if srv_opt.allow_0rtt != null && !srv_opt.allow_0rtt ~}
        0rtt off
%{endif ~}
    }
%{endfor ~}
%{if inputs.ocsp_stapling_off ~}
    ocsp_stapling off
%{endif ~}
%{if inputs.cert_lifetime != "" ~}
    cert_lifetime ${inputs.cert_lifetime}
%{endif ~}
%{for log_name, lg in inputs.log ~}
    log${log_name != "default" ? " ${log_name}" : ""} {
%{if lg.output != "" ~}
        output ${lg.output}%{if lg.file_roll_size != "" || lg.file_roll_keep != null || lg.file_roll_keep_for != ""} {
%{if lg.file_roll_size != "" ~}
            roll_size ${lg.file_roll_size}
%{endif ~}
%{if lg.file_roll_keep != null ~}
            roll_keep ${lg.file_roll_keep}
%{endif ~}
%{if lg.file_roll_keep_for != "" ~}
            roll_keep_for ${lg.file_roll_keep_for}
%{endif ~}
        }%{endif}
%{endif ~}
%{if lg.format != "" ~}
        format ${lg.format}
%{endif ~}
%{if lg.level != "" ~}
        level ${lg.level}
%{endif ~}
%{if [for inc in lg.include : inc] != [] ~}
        include%{for inc in lg.include} ${inc}%{endfor}
%{endif ~}
%{if [for exc in lg.exclude : exc] != [] ~}
        exclude%{for exc in lg.exclude} ${exc}%{endfor}
