%{endif ~}
%{if inputs.fallback_sni != "" ~}
    fallback_sni ${inputs.fallback_sni}
%{endif ~}
%{for ord in inputs.order ~}
    order ${ord.directive} ${ord.position}${ord.target != "" ? " ${ord.target}" : ""}
%{endfor ~}
    storage file_system ${inputs.storage_root != "" ? inputs.storage_root : fs::var()}
%{if inputs.storage_check != "" ~}
    storage_check ${inputs.storage_check}
%{endif ~}
%{if inputs.storage_clean_interval != "" ~}
    storage_clean_interval ${inputs.storage_clean_interval}
%{endif ~}
%{if inputs.renew_interval != "" ~}
    renew_interval ${inputs.renew_interval}
%{endif ~}
%{if inputs.ocsp_interval != "" ~}
    ocsp_interval ${inputs.ocsp_interval}
%{endif ~}
%{if inputs.acme_ca != "" ~}
    acme_ca ${inputs.acme_ca}
%{endif ~}
%{if inputs.acme_ca_root != "" ~}
    acme_ca_root ${inputs.acme_ca_root}
%{endif ~}
%{if inputs.acme_eab != null ~}
    acme_eab {
        key_id ${inputs.acme_eab.key_id}
        mac_key ${inputs.acme_eab.mac_key}
    }
%{endif ~}
%{if !features.trust && inputs.skip_install_trust ~}
    skip_install_trust
%{endif ~}
%{if inputs.email != "" ~}
    email ${inputs.email}
%{endif ~}
%{if features.admin || (inputs.admin != null && inputs.admin.enabled) ~}
    admin ${inputs.admin != null && inputs.admin.listen != "" ? inputs.admin.listen : "127.0.0.1:${self.vars.admin}"} {
%{if inputs.admin != null && inputs.admin.enforce_origin ~}
        enforce_origin
%{endif ~}
%{if inputs.admin != null && [for o in inputs.admin.origins : o] != [] ~}
        origins%{for o in inputs.admin.origins} ${o}%{endfor}
%{endif ~}
    }
%{else ~}
    admin off
%{endif ~}
%{if inputs.on_demand_tls != null ~}
    on_demand_tls {
%{if inputs.on_demand_tls.ask != "" ~}
        ask ${inputs.on_demand_tls.ask}
%{endif ~}
